{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fotobox",
  "version": "../package.json",
  "identifier": "de.se-voelk.fotobox",
  "build": {
    "devUrl": "http://localhost:4200",
    "frontendDist": "../../../dist/apps/fotobox-tauri/web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "Photography",
    "shortDescription": "Fotobox photo booth",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "../../../dist/apps/fotobox-tauri/api/": "api/",
      "../../../scripts/windows/setup-kiosk.ps1": "setup-kiosk.ps1",
      "../../../scripts/windows/FotoboxKiosk.psm1": "FotoboxKiosk.psm1"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["German", "English"],
        "startMenuFolder": "Fotobox"
      }
    }
  }
}
