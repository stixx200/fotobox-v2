{
  "name": "fotobox-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/fotobox-ui/src",
  "tags": ["scope:client", "type:app", "platform:angular"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/fotobox-ui",
          "browser": ""
        },
        "baseHref": "./",
        "index": "apps/fotobox-ui/src/index.html",
        "browser": "apps/fotobox-ui/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/fotobox-ui/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/fotobox-ui/public"
          }
        ],
        "styles": ["apps/fotobox-ui/src/styles.scss"],
        "scripts": [],
        "allowedCommonJsDependencies": ["qrcode", "dijkstrajs"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1.1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "options": {
        "proxyConfig": "apps/fotobox-ui/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "fotobox-ui:build:production"
        },
        "development": {
          "buildTarget": "fotobox-ui:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "fotobox-ui:build"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/fotobox-ui/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "fotobox-ui:build",
        "staticFilePath": "dist/apps/fotobox-ui/browser",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"]
    }
  }
}
