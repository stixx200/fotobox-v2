{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "esnext",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2022",
    "moduleResolution": "bundler",
    // Inline the TypeScript helpers: the generated runtime package.json of
    // the sidecar doesn't list tslib.
    "importHelpers": false
  },
  "include": ["src/**/*.ts"]
}
