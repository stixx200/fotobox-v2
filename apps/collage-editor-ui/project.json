{
  "name": "collage-editor-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/collage-editor-ui/src",
  "tags": ["scope:client", "type:app", "platform:angular"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/collage-editor-ui",
        "baseHref": "./",
        "browser": "apps/collage-editor-ui/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/collage-editor-ui/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/collage-editor-ui/public"
          }
        ],
        "styles": ["apps/collage-editor-ui/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "baseHref": "/",
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "readyWhen": {
        "signal": true
      },
      "options": {
        "port": 4201,
        "proxyConfig": "apps/collage-editor-ui/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "collage-editor-ui:build:production"
        },
        "development": {
          "buildTarget": "collage-editor-ui:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "collage-editor-ui:build",
        "port": 4201,
        "staticFilePath": "dist/apps/collage-editor-ui/browser",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"]
    }
  }
}
