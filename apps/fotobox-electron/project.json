{
  "name": "fotobox-electron",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/fotobox-electron/src",
  "projectType": "application",
  "tags": ["scope:server", "type:app", "platform:electron"],
  "implicitDependencies": ["fotobox-ui", "collage-editor-ui"],
  "targets": {
    "lint": {
      "options": {
        "args": ["**/*.ts"]
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "fotobox-electron:build",
        "inspect": false,
        "runtimeArgs": ["./apps/fotobox-electron/tools/serve-electron.mjs"],
        "runBuildTargetDependencies": true
      },
      "configurations": {
        "production": {
          "buildTarget": "fotobox-electron:build:production"
        },
        "development": {
          "buildTarget": "fotobox-electron:build:development"
        },
        "nest-only": {
          "runtimeArgs": []
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/fotobox-electron",
        "commands": [
          "rspack build",
          "node ../../scripts/copy-electron-assets.mjs"
        ],
        "parallel": false
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"],
          "dependsOn": [
            {
              "projects": ["fotobox-ui", "collage-editor-ui"],
              "target": "build",
              "params": "forward"
            }
          ]
        },
        "production": {
          "args": ["--node-env=production"],
          "dependsOn": [
            {
              "projects": ["fotobox-ui", "collage-editor-ui"],
              "target": "build",
              "params": "forward"
            }
          ]
        }
      }
    },
    "verify-dist": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build",
          "params": "forward"
        }
      ],
      "options": {
        "command": "node scripts/verify-electron-dist.mjs"
      }
    },
    "package": {
      "executor": "nx-electron:package",
      "dependsOn": [
        {
          "target": "verify-dist",
          "params": "forward"
        }
      ],
      "defaultConfiguration": "production",
      "options": {
        "name": "fotobox-electron",
        "frontendProject": "fotobox-ui",
        "extraProjects": ["collage-editor-ui"],
        "sourcePath": "dist/apps",
        "outputPath": "dist/packages",
        "platform": ["mac", "windows"]
      },
      "configurations": {
        "production": {
          "dependsOn": [
            {
              "target": "verify-dist",
              "params": "forward"
            }
          ]
        }
      }
    }
  }
}
